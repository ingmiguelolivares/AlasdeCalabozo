<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <mimeMap fileExtension=".br" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".data" mimeType="application/octet-stream" />
    </staticContent>
    <rewrite>
      <outboundRules>
        <rule name="Brotli encoding for Unity WebGL" preCondition="IsBrotliFile">
          <match serverVariable="RESPONSE_Content-Encoding" pattern=".*" />
          <action type="Rewrite" value="br" />
        </rule>
        <preConditions>
          <preCondition name="IsBrotliFile">
            <add input="{REQUEST_FILENAME}" pattern="\.br$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="public, max-age=31536000, immutable" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
