    m_PersistentCalls:
      m_Calls: []
  m_text: "Al talentoso equipo de dise\xF1o 3D, les agradecemos por esculpir las
    criaturas y tesoros que habitan esta historia. Sus creaciones le dieron forma
    al reino que hoy exploran los jugadores:\n\nBerchello - Director Dise\xF1o 3D
    / Esfinge\nAndres Moya - Abominacion Yuan Ti\nAnjhi Tatiana Bonilla- Orc\nCristhian
    Rodriguez - Extra\xF1o De Agua \nDaniel Colmenares - Tumulario\nDaren Herrera
    - Abyss Nothic\nDavid Cardenas - Tarrasque\nErwin Santiago Pardo - Dracoliche
    \nJean Luis Osorio - SlaadGris\nJuan Camilo Alvarez - BestiaTremula \nJuan Jose
    Camacho - Ent\nJuan Pablo Avila - Gnoll \nJuan Sebastian Quintero - Mimic/Thri-Kreen\nJulian
    David Colmenares - Marid \nJulian Ricardo Mancera - Minotauro\nJuliana Cavicchioli
    - DragonFeerico \nLeidy Katerin Pinzon - Pixie \nLiceth Leguizam\xF3n - Homundraak
    Oropel \nMike Sebastian Casta\xF1eda - Centauro\nSebasti\xE1n Rodr\xEDguez -
    Azotamentes\nStefany Lopez - MyconidSovereign \nWilliam Cubillos - Bullywug\nYesid
    Camayo - Elemental De Fuego \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
  m_isRightToLeft: 0
